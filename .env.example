# Скопируйте в .env и заполните

# --- LLM (OpenAI-совместимый API) ---
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0

# --- Эмбеддинги ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# --- Данные ---
RESUMES_DIR=data/resumes
INDEX_DIR=data/index
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SEARCH_TOP_K=5

# --- API hh.ru (токен работодателя с доступом к базе резюме) ---
HH_ACCESS_TOKEN=
# hh.ru требует User-Agent в формате "Название/версия (email)"
HH_USER_AGENT=ResumeRAGAssistant/0.1 (you@example.com)
